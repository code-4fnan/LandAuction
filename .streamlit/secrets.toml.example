# Copy to .streamlit/secrets.toml for local overrides, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Every key is optional.

# Leave unset to use the built-in SQLite file (data/landauction.db).
# Set to a hosted Postgres URL (Neon, Supabase, ...) so data survives app restarts:
# DATABASE_URL = "postgresql+psycopg://user:password@host/dbname?sslmode=require"

APP_TIMEZONE = "Asia/Kolkata"
CURRENCY_SYMBOL = "₹"
SEED_DEMO_DATA = "true"       # add demo users, parcels and bids to an empty database
ANTI_SNIPE_SECONDS = "120"    # late bids extend the auction by this much
MAX_AUCTION_DAYS = "60"
REFRESH_SECONDS = "3"         # how often auction rooms poll for new bids
